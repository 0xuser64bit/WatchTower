[Unit]
Description=ChainSentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chainsentinel
Group=chainsentinel
WorkingDirectory=/opt/chainsentinel
ExecStart=/opt/chainsentinel/chainsentinel
EnvironmentFile=/opt/chainsentinel/.env
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
