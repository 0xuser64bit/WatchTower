# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Authorized admins, comma-separated numeric Telegram user IDs
ADMIN_TELEGRAM_IDS=123456789

# SQLite database URL (the parent directory is created automatically)
DATABASE_URL=sqlite://data/chainsentinel.db

# Price providers
COINGECKO_API_URL=https://api.coingecko.com/api/v3
PRICE_FALLBACK_URLS=

# Solana RPC (comma-separated; first is primary)
SOLANA_RPC_ENDPOINTS=https://api.mainnet-beta.solana.com
SOLANA_RPC_COMMITMENT=confirmed

# Engine
POLL_INTERVAL_SECONDS=60
ALERT_DEFAULT_COOLDOWN_SECONDS=300

# Logging
RUST_LOG=info,chainsentinel=debug
