# WatchTower configuration.
#
# Prefer `watchtower setup` (or `./scripts/ctl.sh setup`): it explains each
# variable, live-checks Telegram / CoinGecko / Solana RPC, and writes this file.
# Copying the example by hand still works. Everything except the two required
# values has a working default.
#
# The daemon refuses to start on an invalid value rather than falling back silently.

# ── Required ──────────────────────────────────────────────────────────────────────

# From @BotFather. Format: <bot_id>:<secret>. Treat as a credential: anyone holding
# it controls the bot.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs granted admin on first start. Get yours
# from @userinfobot.
#
# These only SEED the users table; the database is the authority afterwards. Removing
# an ID here does not revoke access, and an admin demoted through the bot is not
# re-promoted on restart. Leave it empty and the daemon will not start — that is
# deliberate, because a placeholder here would grant a stranger control of the bot.
ADMIN_TELEGRAM_IDS=

# ── Storage ───────────────────────────────────────────────────────────────────────

# SQLite only. The parent directory is created automatically.
# DATABASE_URL=sqlite://data/watchtower.db

# ── Providers ─────────────────────────────────────────────────────────────────────

# Ordered list of CoinGecko-compatible API roots. The first is primary; the rest are
# tried in order when it fails.
# COINGECKO_API_URLS=https://api.coingecko.com/api/v3

# Optional CoinGecko API key. Strongly recommended: the free unauthenticated tier
# rate-limits hard, which shows up as missed price polls. Sent as `x-cg-demo-api-key`,
# or `x-cg-pro-api-key` when the URL points at pro-api.coingecko.com.
# COINGECKO_API_KEY=

# Ordered list of Solana JSON-RPC endpoints. Give at least two in production: an
# endpoint that fails is benched for 60s and traffic moves to the next one. The public
# mainnet endpoint is heavily rate-limited and is not suitable on its own.
# SOLANA_RPC_ENDPOINTS=https://api.mainnet-beta.solana.com

# processed | confirmed | finalized
# SOLANA_RPC_COMMITMENT=confirmed

# Per-request HTTP timeout, in seconds (1-120).
# HTTP_TIMEOUT_SECONDS=10

# ── Engine ────────────────────────────────────────────────────────────────────────

# Seconds between polls (10-86400). Each poll costs one price request per tracked
# token plus one batched RPC call for all wallets, so lower values need an API key
# and a private RPC endpoint.
# POLL_INTERVAL_SECONDS=60

# Default minimum seconds between repeat alerts for a new rule (0-86400); each rule
# stores its own value, chosen during /addalert.
#
# Alerts are edge-triggered: a rule fires when its condition becomes true and stays
# quiet until the condition clears. Cooldown only limits a condition that keeps
# flipping across the threshold.
# ALERT_DEFAULT_COOLDOWN_SECONDS=300

# Days of alert history to keep (1-3650). Pruned every 6 hours.
# ALERT_HISTORY_RETENTION_DAYS=90

# ── Logging ───────────────────────────────────────────────────────────────────────

# Logs go to stdout and to a daily rolling file in LOG_DIR.
# RUST_LOG=info,watchtower=info
# LOG_DIR=logs
# LOG_MAX_FILES=14
